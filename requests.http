@baseUrl = http://localhost:8080/api/v1

### 1. Create category: Food
# @name food
POST {{baseUrl}}/categories
Content-Type: application/json

{ "name": "Food", "color": "#FF8800" }

### 2. Create category: Travel
# @name travel
POST {{baseUrl}}/categories
Content-Type: application/json

{ "name": "Travel", "color": "#3366CC" }

### 3. Expense: groceries
POST {{baseUrl}}/expenses
Content-Type: application/json

{ "amount": 250.50, "categoryId": {{food.response.body.id}},
  "expenseDate": "2026-11-03", "description": "Groceries" }

### 4. Expense: dinner
POST {{baseUrl}}/expenses
Content-Type: application/json

{ "amount": 120.00, "categoryId": {{food.response.body.id}},
  "expenseDate": "2026-11-10", "description": "Dinner" }

### 5. Expense: train ticket
POST {{baseUrl}}/expenses
Content-Type: application/json

{ "amount": 349.50, "categoryId": {{travel.response.body.id}},
  "expenseDate": "2026-11-15", "description": "Train" }

### 6. Overall budget for November
PUT {{baseUrl}}/budgets
Content-Type: application/json

{ "month": "2026-11", "amount": 1000 }

### 7. Food budget for November
PUT {{baseUrl}}/budgets
Content-Type: application/json

{ "month": "2026-11", "categoryId": {{food.response.body.id}}, "amount": 400 }

### 8. THE REPORT
GET {{baseUrl}}/reports/monthly?month=2026-11

### 9. Expense list (newest first)
GET {{baseUrl}}/expenses?page=0&size=20